# Copy to .env on the server and replace every blank value. Never commit .env.
POSTGRES_ADMIN_PASSWORD=
ANALYTICS_DB_PASSWORD=
UMAMI_DB_PASSWORD=
ANALYTICS_DATABASE_URL=
UMAMI_DATABASE_URL=
UMAMI_APP_SECRET=
# Written automatically by deploy-analytics.sh (init-umami) and locked to mode 600.
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=
UMAMI_WEBSITE_ID=
# Optional: override the Umami admin account used by init-umami (defaults to admin/umami).
UMAMI_ADMIN_USERNAME=
UMAMI_ADMIN_PASSWORD=
ANALYTICS_ADMIN_PASSWORD_HASH=
ANALYTICS_INTERNAL_TOKEN=
ANALYTICS_SESSION_SECRET=
ANALYTICS_COLLECTED_SINCE=
ANALYTICS_SMTP_AUTHORIZATION_CODE=
ANALYTICS_ADMIN_EMAIL=ze.jiang@hhu.edu.cn
ANALYTICS_SMTP_HOST=smtp.126.com
ANALYTICS_SMTP_PORT=465
ANALYTICS_SMTP_USERNAME=zejiang_hydrology@126.com
ANALYTICS_REPORT_FROM=zejiang_hydrology@126.com
ANALYTICS_REPORT_TO=ze.jiang@hhu.edu.cn

# LISFLOOD Web surface-model inputs and generated cache (server paths).
LISFLOOD_MODEL_DIR=/opt/hydroclimatex-wasp/lisflood-private/model
LISFLOOD_CACHE_DIR=/opt/hydroclimatex-wasp/state/lisflood-cache
